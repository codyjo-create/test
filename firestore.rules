rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidStudentId(studentId) {
      return studentId is string && studentId.size() >= 1 && studentId.size() <= 2 && studentId.matches('^([1-9]|[12][0-9]|30)$');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'codyjo@geminiedu.site'
      );
    }

    // --- Validation Blueprints ---
    function isValidAdmin(data, adminId) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
        isValidId(data.uid) &&
        data.uid == adminId &&
        data.role == 'admin' &&
        data.createdAt is timestamp;
    }

    function isValidStudent(data, studentId) {
      return data.keys().hasAll([
          'studentNumber', 'studentName', 'projectTitle', 'homepageUrl',
          'description', 'submittedByUid', 'submittedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentNumber', 'studentName', 'projectTitle', 'homepageUrl',
          'description', 'submittedByUid', 'submittedByName', 'createdAt', 'updatedAt'
        ]) &&
        data.studentNumber is int &&
        data.studentNumber >= 1 &&
        data.studentNumber <= 30 &&
        string(data.studentNumber) == studentId &&
        data.studentName is string &&
        data.studentName.size() >= 1 &&
        data.studentName.size() <= 40 &&
        data.projectTitle is string &&
        data.projectTitle.size() >= 1 &&
        data.projectTitle.size() <= 80 &&
        data.homepageUrl is string &&
        data.homepageUrl.size() >= 8 &&
        data.homepageUrl.size() <= 300 &&
        data.homepageUrl.matches('^https?://[a-zA-Z0-9.-]+\\.[a-zA-Z]{2,}(:[0-9]{1,5})?(/.*)?$') &&
        data.description is string &&
        data.description.size() <= 240 &&
        isValidId(data.submittedByUid) &&
        data.submittedByName is string &&
        data.submittedByName.size() >= 1 &&
        data.submittedByName.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidJudge(data, judgeId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'affiliation', 'specialty', 'status', 'registeredAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'affiliation', 'specialty', 'status', 'registeredAt', 'updatedAt'
        ]) &&
        isValidId(data.uid) &&
        data.uid == judgeId &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 40 &&
        data.affiliation is string &&
        data.affiliation.size() <= 60 &&
        data.specialty is string &&
        data.specialty.size() <= 40 &&
        data.status == 'active' &&
        data.registeredAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidScore(val) {
      return val is int && val >= 0 && val <= 25;
    }

    function isValidEvaluation(data, evaluationId) {
      return data.keys().hasAll([
          'studentId', 'studentNumber', 'judgeUid', 'judgeName',
          'designScore', 'creativityScore', 'functionalityScore', 'contentScore',
          'totalScore', 'comment', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentId', 'studentNumber', 'judgeUid', 'judgeName',
          'designScore', 'creativityScore', 'functionalityScore', 'contentScore',
          'totalScore', 'comment', 'createdAt', 'updatedAt'
        ]) &&
        isValidStudentId(data.studentId) &&
        data.studentNumber is int &&
        data.studentNumber >= 1 &&
        data.studentNumber <= 30 &&
        string(data.studentNumber) == data.studentId &&
        isValidId(data.judgeUid) &&
        evaluationId == (data.judgeUid + '_' + data.studentId) &&
        data.judgeName is string &&
        data.judgeName.size() >= 1 &&
        data.judgeName.size() <= 40 &&
        isValidScore(data.designScore) &&
        isValidScore(data.creativityScore) &&
        isValidScore(data.functionalityScore) &&
        isValidScore(data.contentScore) &&
        data.totalScore is int &&
        data.totalScore >= 0 &&
        data.totalScore <= 100 &&
        data.totalScore == (data.designScore + data.creativityScore + data.functionalityScore + data.contentScore) &&
        data.comment is string &&
        data.comment.size() <= 500 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin() && resource.data.role == 'admin';
      allow create: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming(), adminId) && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isAdmin() && isValidId(adminId);
    }

    match /students/{studentId} {
      allow get: if isSignedIn() && isValidStudentId(studentId);
      allow list: if isSignedIn() && resource.data.studentNumber >= 1 && resource.data.studentNumber <= 30;
      allow create: if isVerifiedUser() &&
        isValidStudentId(studentId) &&
        isValidStudent(incoming(), studentId) &&
        incoming().submittedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidStudentId(studentId) &&
        isValidStudent(incoming(), studentId) &&
        (existing().submittedByUid == request.auth.uid || isAdmin()) &&
        incoming().studentNumber == existing().studentNumber &&
        incoming().submittedByUid == existing().submittedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'studentName', 'projectTitle', 'homepageUrl', 'description', 'submittedByName', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() &&
        isValidStudentId(studentId) &&
        (existing().submittedByUid == request.auth.uid || isAdmin());
    }

    match /judges/{judgeId} {
      allow get: if isSignedIn() && isValidId(judgeId);
      allow list: if isSignedIn() && resource.data.status == 'active';
      allow create: if isVerifiedUser() &&
        isValidId(judgeId) &&
        judgeId == request.auth.uid &&
        isValidJudge(incoming(), judgeId) &&
        incoming().registeredAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(judgeId) &&
        isValidJudge(incoming(), judgeId) &&
        (judgeId == request.auth.uid || isAdmin()) &&
        incoming().uid == existing().uid &&
        incoming().registeredAt == existing().registeredAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'affiliation', 'specialty', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(judgeId) && (judgeId == request.auth.uid || isAdmin());
    }

    match /evaluations/{evaluationId} {
      allow get: if isSignedIn() && isValidId(evaluationId);
      allow list: if isSignedIn() &&
        resource.data.studentNumber >= 1 &&
        resource.data.studentNumber <= 30 &&
        resource.data.totalScore >= 0 &&
        resource.data.totalScore <= 100;
      allow create: if isVerifiedUser() &&
        isValidId(evaluationId) &&
        isValidEvaluation(incoming(), evaluationId) &&
        incoming().judgeUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        exists(/databases/$(database)/documents/judges/$(request.auth.uid)) &&
        exists(/databases/$(database)/documents/students/$(incoming().studentId));
      allow update: if isVerifiedUser() &&
        isValidId(evaluationId) &&
        isValidEvaluation(incoming(), evaluationId) &&
        (existing().judgeUid == request.auth.uid || isAdmin()) &&
        incoming().studentId == existing().studentId &&
        incoming().studentNumber == existing().studentNumber &&
        incoming().judgeUid == existing().judgeUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'judgeName', 'designScore', 'creativityScore', 'functionalityScore', 'contentScore', 'totalScore', 'comment', 'updatedAt'
        ]) &&
        exists(/databases/$(database)/documents/judges/$(existing().judgeUid)) &&
        exists(/databases/$(database)/documents/students/$(existing().studentId));
      allow delete: if isVerifiedUser() && isValidId(evaluationId) && (existing().judgeUid == request.auth.uid || isAdmin());
    }
  }
}
